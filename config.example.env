# WDA-MCP Configuration — copy to .env and fill in your values

# Required: your iPhone's UDID (find with: xcrun xctrace list devices)
WDA_DEVICE_ID=00008120-XXXXXXXXXXXXXXXX

# Required: WDA bundle ID (the one you set in Xcode, with .xctrunner suffix)
WDA_BUNDLE_ID=com.yourname.WebDriverAgentRunner.xctrunner

# Optional: Tailscale IP for remote/5G access (find in Tailscale app on iPhone)
WDA_TAILSCALE_IP=100.x.x.x

# Optional: paths
WDA_PROJECT_DIR=~/Desktop/WebDriverAgent
WDA_SCREENSHOTS_DIR=~/screenshots

# HTTP mode bind address. Defaults to 0.0.0.0 (matches old behavior). Set to
# 127.0.0.1 if you only expose 8200 via a local reverse proxy / cloudflared and
# want to refuse direct LAN/WAN connections.
# WDA_HTTP_HOST=127.0.0.1
# WDA_HTTP_PORT=8200

# OAuth credentials for HTTP mode. Prefer ~/.wda-oauth.json (chmod 600), generate with:
#   python scripts/generate_oauth_creds.py
# Or set these env vars (server.py refuses to start in --http mode without an access token):
# WDA_OAUTH_CLIENT_ID=
# WDA_OAUTH_CLIENT_SECRET=
# WDA_OAUTH_ACCESS_TOKEN=
