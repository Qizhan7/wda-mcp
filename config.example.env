# WDA-MCP Configuration — copy to .env and fill in your values

# Required: your iPhone's UDID (find with: xcrun xctrace list devices)
WDA_DEVICE_ID=00008120-XXXXXXXXXXXXXXXX

# Required: WDA bundle ID (the one you set in Xcode, with .xctrunner suffix)
WDA_BUNDLE_ID=com.yourname.WebDriverAgentRunner.xctrunner

# Optional: Tailscale IP for remote/5G access (find in Tailscale app on iPhone)
WDA_TAILSCALE_IP=100.x.x.x

# Optional: paths
WDA_PROJECT_DIR=~/Desktop/WebDriverAgent
WDA_SCREENSHOTS_DIR=~/screenshots
